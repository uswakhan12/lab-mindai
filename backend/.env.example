PORT=8080
TAVILY_API_KEY=tvly-your-key-here
GROQ_API_KEY=gsk_your-groq-key
LLAMA8_MODEL=llama-3.1-8b-instant
LLAMA70_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Optional: shared API key for all mutating/read review routes (omit in local dev).
# When set, clients must send Authorization: Bearer <key> or x-api-key: <key>.
LABMIND_API_KEY=

# Optional: Postgres instead of SQLite for reviews (omit to use backend/data/labmind.sqlite).
# DATABASE_URL=postgres://labmind:labmind@localhost:5432/labmind
