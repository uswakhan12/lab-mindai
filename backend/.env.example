PORT=8080
TAVILY_API_KEY=tvly-your-key-here
GROQ_API_KEY=gsk_your-groq-key
LLAMA8_MODEL=llama-3.1-8b-instant
LLAMA70_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your-gemini-api-key
# Use Flash for free-tier keys (gemini-1.5-pro is remapped to Flash in code). Secondary Gemini models are opt-in
# (e.g. gemini-2.0-flash) because many free tiers show limit 0 for 2.x.
GEMINI_MODEL=gemini-1.5-flash
#GEMINI_SECONDARY_MODEL=gemini-2.0-flash

# After the primary LLAMA70_MODEL fails (e.g. Groq 429), experiment-plan tries these Groq models before Gemini.
# Defaults include LLAMA8_MODEL then llama-3.1-8b-instant. Override order with:
#EXPERIMENT_PLAN_LLAMA_FALLBACK_MODEL=llama-3.1-8b-instant

# Optional: OpenAI embeddings for semantic novelty rerank (hypothesis vs each reference).
#OPENAI_API_KEY=
#OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: run a full second planner pass without prior reviews for true A/B quality (doubles LLM cost).
# Client can also send JSON body: "dualFeedbackAb": true
#LABMIND_DUAL_FEEDBACK_AB=1

# Set to 1 to enforce strict HTTP failures (502/422) when LLM output, JSON parse, safety, procurement grounding,
# or governance gates fail. Omit or leave unset for resilient release (stub/repair/degraded warnings + 200).
#LABMIND_STRICT_PLAN_GATES=1

# Optional: shared API key for all mutating/read review routes (omit in local dev).
# When set, clients must send Authorization: Bearer <key> or x-api-key: <key>.
#LABMIND_API_KEY=

# Optional: Postgres instead of SQLite for reviews (omit to use backend/data/labmind.sqlite).
# DATABASE_URL=postgres://labmind:labmind@localhost:5432/labmind
